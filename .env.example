# ============================================================
# LAND REGISTRATION BLOCKCHAIN PLATFORM - ENVIRONMENT CONFIG
# ============================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL or SQLite fallback for native local run)
# For PostgreSQL (Docker or local):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/land_registry?schema=public"
# For zero-dependency SQLite local test/dev:
# DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="super-secure-jwt-secret-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Blockchain Configuration (Hardhat local node default)
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"
# Account #0 from default Hardhat local testnode (Do NOT use in mainnet!)
ADMIN_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
REGISTRAR_PRIVATE_KEY="0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d"

# Document Storage Path
STORAGE_PATH="./uploads"
MAX_FILE_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
